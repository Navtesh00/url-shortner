{
  "name": "url-shortner",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/Navtesh00/url-shortner#readme",
  "bugs": {
    "url": "https://github.com/Navtesh00/url-shortner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Navtesh00/url-shortner.git"
  },
  "author": "Navtesh",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "transform": {
      "^.+\\.[m]?js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!nanoid)"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/db.js",
      "!src/config/bullMQ.js",
      "!src/workers/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "dependencies": {
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.1",
    "nanoid": "^6.0.1",
    "nodemon": "^1.14.10"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2"
  }
}
